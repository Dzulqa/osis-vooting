# Copy to .env and fill in. .env is git-ignored.

# --- Database (local docker: `npm run db:up`) ---
DATABASE_URL="mysql://suara:suara@127.0.0.1:3307/suara?connection_limit=5"
SHADOW_DATABASE_URL="mysql://suara:suara@127.0.0.1:3307/suara_shadow"
TEST_DATABASE_URL="mysql://suara:suara@127.0.0.1:3307/suara_test"

# --- E-raport service API (server-side only, NEVER NEXT_PUBLIC_) ---
SCHOOL_API_URL="https://sinar.smkalamanah.sch.id/api/service"
SCHOOL_API_KEY=""
SCHOOL_API_SECRET=""

# --- Auth ---
SESSION_TTL_HOURS=12
BOOTH_TOKEN_TTL_DAYS=3
AUTH_COOKIE_SECURE=false
APP_ORIGIN="http://localhost:3000"

# --- First superadmin (seed). Seed refuses empty/weak values when NODE_ENV=production ---
SEED_SUPERADMIN_USERNAME="superadmin"
SEED_SUPERADMIN_PASSWORD=""

# --- Uploads (candidate photos). In production keep this OUTSIDE the release dir ---
UPLOAD_DIR="./.uploads"
